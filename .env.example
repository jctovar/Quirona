# ─────────────────────────────────────────────────────────────
#  Variables de entorno de QUIRONA (Vite)
# ─────────────────────────────────────────────────────────────
#  1. Copia este archivo como ".env" en la raíz del proyecto:
#        cp .env.example .env
#  2. Completa los valores con los de tu proyecto de Supabase:
#        Supabase Dashboard > Project Settings > API
#
#  IMPORTANTE:
#  - Todo lo que empiece con VITE_ se incrusta en el bundle que
#    descarga el navegador. La app solo usa la clave pública.
#  - La service_role de la sección E2E se usa únicamente en Node
#    (Playwright); nunca debe llevar prefijo VITE_ ni subirse al repo.
#  - El archivo ".env" está en .gitignore: no lo subas al repo.
# ─────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-o-publishable-key>

# ─────────────────────────────────────────────────────────────
#  Pruebas E2E (solo local y CI)
#  Ninguna de estas variables lleva el prefijo VITE_, por lo que
#  NO se incluyen en el bundle del navegador.
#  Usa una cuenta de prueba dedicada: el setup la crea y el
#  teardown la elimina en cada ejecución.
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=<service-role-o-secret-key-solo-para-e2e>
E2E_USER_EMAIL=e2e.playwright@example.com
E2E_USER_PASSWORD=<contraseña-del-usuario-de-prueba>
