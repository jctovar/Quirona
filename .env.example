# ─────────────────────────────────────────────────────────────
#  Variables de entorno de QUIRONA (Vite)
# ─────────────────────────────────────────────────────────────
#  1. Copia este archivo como ".env" en la raíz del proyecto:
#        cp .env.example .env
#  2. Completa los valores con los de tu proyecto de Supabase:
#        Supabase Dashboard > Project Settings > API
#
#  IMPORTANTE:
#  - Todo lo que empiece con VITE_ se incrusta en el bundle que
#    descarga el navegador, así que NUNCA pongas aquí claves
#    privadas ("service_role" o "sb_secret_...").
#  - Usa únicamente la clave pública (anon / publishable).
#  - El archivo ".env" está en .gitignore: no lo subas al repo.
# ─────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-o-publishable-key>
